<div {{#if isHidden}}hidden{{/if}}>
  <div class="{{classes.container-profile}}">
    <label class="{{classes.label-profile}}" for={{name}}>{{labelValue}}</label>
    <input class="{{classes.input-profile}}" type="{{type}}" name="{{name}}" id="{{name}}" value="{{value}}" {{#if isFrozen}}disabled{{/if}}>
  </div>
  <span class="{{classes.error}}">{{error}}</span>
</div>